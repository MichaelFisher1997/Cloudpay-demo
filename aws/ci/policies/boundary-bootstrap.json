{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "OnlyInitializationSecretReads",
      "Effect": "Allow",
      "Action": "secretsmanager:GetSecretValue",
      "Resource": [
        "arn:aws:secretsmanager:eu-west-2:218549829565:secret:godiffy-dev-runtime-*",
        "arn:aws:secretsmanager:eu-west-2:218549829565:secret:godiffy-dev-migration-*"
      ]
    },
    {
      "Sid": "OnlyInitializationSecretWrites",
      "Effect": "Allow",
      "Action": "secretsmanager:PutSecretValue",
      "Resource": [
        "arn:aws:secretsmanager:eu-west-2:218549829565:secret:godiffy-dev-runtime-*",
        "arn:aws:secretsmanager:eu-west-2:218549829565:secret:godiffy-dev-migration-*"
      ]
    }
  ]
}
