{
  "name": "godiffy",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --host 0.0.0.0",
    "build": "vite build",
    "start": "bun .output/server/index.mjs",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "db:migrate": "bun scripts/migrate.ts",
    "db:bootstrap": "bun scripts/bootstrap.ts",
    "db:verify": "bun scripts/verify-db.ts",
    "smoke:aws": "bun scripts/aws-smoke.ts",
    "test:built": "bun run build && bun scripts/test-built.ts",
    "format": "prettier --write src scripts tests vite.config.ts",
    "format:check": "prettier --check src scripts tests vite.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1147.0",
    "@aws-sdk/client-secrets-manager": "3.1147.0",
    "@aws-sdk/s3-presigned-post": "3.1147.0",
    "@aws-sdk/s3-request-presigner": "3.1147.0",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-start": "1.168.60",
    "better-auth": "1.7.7",
    "image-size": "2.0.4",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "nitro": "3.0.260903-beta",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "vite": "8.3.3"
  }
}
